FROM python:3.11-slim

WORKDIR /code
ENV PYTHONPATH=/code
ENV PORT=7860

COPY backend/requirements.txt /code/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /code/backend/requirements.txt

COPY --from=artifacts checkpoints/deploy.pt /code/local_artifacts/gru_small_250/checkpoints/deploy.pt
COPY --from=artifacts vocabulary.json /code/local_artifacts/gru_small_250/vocabulary.json
COPY --from=artifacts config/experiment_config.json /code/local_artifacts/gru_small_250/config/experiment_config.json
COPY --from=artifacts deployment_manifest.json /code/local_artifacts/gru_small_250/deployment_manifest.json

COPY backend /code/backend
COPY src /code/src
COPY data/seed /code/data/seed

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import json, os, urllib.request; port = os.environ.get('PORT', '7860'); response = urllib.request.urlopen(f'http://127.0.0.1:{port}/', timeout=5); payload = json.load(response); assert payload['model_loaded'] is True"

CMD ["sh", "-c", "exec gunicorn --chdir /code backend.app:app --bind 0.0.0.0:${PORT:-7860} --timeout 120"]
